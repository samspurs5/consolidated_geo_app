{
  "version": 8,
  "sources": {
    "omt": {
      "type": "vector",
      "url": "pmtiles:///tiles/region.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f8f4f0" } },
    { "id": "landcover-grass", "type": "fill", "source": "omt", "source-layer": "landcover",
      "filter": ["in", "class", "grass", "wood", "scrub"],
      "paint": { "fill-color": "#d8e8c8", "fill-opacity": 0.6 } },
    { "id": "park", "type": "fill", "source": "omt", "source-layer": "park",
      "paint": { "fill-color": "#c8e0a8", "fill-opacity": 0.6 } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water",
      "paint": { "fill-color": "#a0c8f0" } },
    { "id": "buildings", "type": "fill", "source": "omt", "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#dcd2bc", "fill-outline-color": "#c8bea8" } },
    { "id": "roads-minor", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"],
      "minzoom": 13,
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 4] } },
    { "id": "roads-tertiary", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["==", "class", "tertiary"],
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 18, 8] } },
    { "id": "roads-secondary", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": { "line-color": "#fcd6a4", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 18, 10] } },
    { "id": "roads-primary", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": { "line-color": "#fcd6a4", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 18, 14] } },
    { "id": "highways", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": { "line-color": "#e9ac77", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 18, 18] } },
    { "id": "boundary", "type": "line", "source": "omt", "source-layer": "boundary",
      "filter": ["<=", "admin_level", 4],
      "paint": { "line-color": "#aaa", "line-width": 1, "line-dasharray": [2, 2] } }
  ]
}
