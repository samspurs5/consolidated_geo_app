# GraphHopper graph cache (large binary files – never commit)
data/default-gh/*
!data/default-gh/.gitkeep

# OSM data (can be large – never commit)
data/osm/*.pbf
data/osm/*.osm
data/osm/*.osc
data/osm/*.osc.gz
data/osm/updates/
data/osm/state.txt
data/osm/*.lock
data/osm/*.tmp

# Vector tiles produced by scripts/build-tiles.sh
data/tiles/*.pmtiles
data/tiles/*.mbtiles
!data/tiles/.gitkeep

# Frontend JS vendored by scripts/fetch-frontend-vendor.sh
api/app/static/vendor/*.js
api/app/static/vendor/*.css
!api/app/static/vendor/.gitkeep

# Air-gap image bundle
geo-stack-images.tar.gz

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# Environment
.env
*.local.env

# Editor
.vscode/
.idea/
*.swp
