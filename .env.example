# Copy this to .env and adjust values for your deployment.

# --- Data ---
OSM_PBF_FILE=region.pbf

# --- Overpass ---
# Set to "rules" after the first successful init to skip re-importing.
OVERPASS_MODE=init
OVERPASS_META=yes
OVERPASS_SPACE=4294967296    # bytes (4 GiB)

# For online environments: point to a replication server.
# For air-gapped setups: leave empty or point at a local mirror.
REPLICATION_URL=https://planet.openstreetmap.org/replication/minute
# REPLICATION_URL=http://my-local-mirror/replication/minute
OVERPASS_DIFF_URL=

# --- GraphHopper ---
GH_JAVA_OPTS=-Xmx2g -Xms512m -XX:+UseG1GC

# --- API ---
API_PORT=8000

# --- LLM (chat assistant) ---
# Any tool-calling-capable Ollama tag. The compose entrypoint pulls this
# on first start; switch and re-up the ollama container to change models.
OLLAMA_MODEL=gemma3:4b
