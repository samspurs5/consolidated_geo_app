# Copy this to .env and adjust values for your deployment.

# --- Data ---
OSM_PBF_FILE=region.pbf

# --- Overpass ---
# Set to "rules" after the first successful init to skip re-importing.
OVERPASS_MODE=init
OVERPASS_META=yes
OVERPASS_SPACE=4294967296    # bytes (4 GiB)

# For online environments: point to a replication server.
# For air-gapped setups: leave empty or point at a local mirror.
REPLICATION_URL=https://planet.openstreetmap.org/replication/minute
# REPLICATION_URL=http://my-local-mirror/replication/minute
OVERPASS_DIFF_URL=

# --- GraphHopper ---
# Tuned for a 16 GB laptop running the whole stack + browser.
# Bump to -Xmx2g (or higher) for larger regions on a workstation.
GH_JAVA_OPTS=-Xmx1g -Xms256m -XX:+UseG1GC

# --- API ---
API_PORT=8000

# --- LLM (chat assistant) ---
# Any tool-calling-capable Ollama tag. The compose entrypoint pulls this
# on first start; switch and re-up the ollama container to change models.
#
# Recommended:
#   qwen2.5:3b   — ~2 GB resident, default — fits a 16 GB laptop
#   qwen2.5:7b   — ~5 GB resident, stronger but tight on 16 GB
#   llama3.2:3b  — ~2 GB resident, solid alternative
OLLAMA_MODEL=qwen2.5:3b

# --- Live data feed (MQTT + providers) ---
# Comma-separated list of built-in provider adapters to start. Each
# polls its upstream source and republishes to live/<name>/<id> on
# the local Mosquitto broker. Leave empty to accept external
# publishers only.
#
# Supported: random_walker, movebank
PROVIDERS=

# Movebank — only used when "movebank" is in PROVIDERS above.
# Get credentials at https://www.movebank.org and the numeric study
# id from a study's URL or its API metadata.
MOVEBANK_USERNAME=
MOVEBANK_PASSWORD=
MOVEBANK_STUDY_ID=
MOVEBANK_POLL_SECONDS=60

# random_walker demo provider — defaults to a centre near Monaco.
WALKER_LAT=43.74
WALKER_LON=7.42
